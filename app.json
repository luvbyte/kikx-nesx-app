{
  "name": "com.lvbyte.nesx",
  "title": "NesX",
  "author": "luvbyte",
  "category": "Games",
  "description": "Nes Emulator",
  "version": "0.1.2",
  "kikx_version": "0.4.3",

  "include": ["public", "www"],

  "iframe": {
    "allowfullscreen": true,
    "sandbox": ["allow-scripts"]
  },

  "services": ["fs"],

  "service_config": {
    "fs": {
      "home": "read"
    }
  },

  "share": {
    "message": "Play game",
    "types": ["file"],
    "accept": [".nes", ".nsf"]
  },

  "theme": "dark"
}
